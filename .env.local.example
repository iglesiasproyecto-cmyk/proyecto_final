# Local development - Supabase CLI & MCP Setup
# Get SUPABASE_PROJECT_REF from your Supabase project URL
SUPABASE_PROJECT_REF=your-project-ref-here

# SUPABASE_ACCESS_TOKEN: Personal Access Token for Supabase CLI
# Generate at: https://app.supabase.com/account/tokens
# WARNING: Never commit this to git - it has full admin access to your project
SUPABASE_ACCESS_TOKEN=your-personal-access-token-here
